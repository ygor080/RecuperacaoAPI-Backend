# Porta em que a API será executada
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Variáveis separadas
DB_HOST=seu-host-aiven.aivencloud.com
DB_PORT=PORTA
DB_USER=avnadmin
DB_PASSWORD=sua-senha-aqui
DB_NAME=defaultdb2
DB_SSL=true

# Segredo utilizado para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque-este-valor-por-um-segredo-forte
JWT_EXPIRES_IN=8h

# URL pública do front-end autorizado a consumir a API (CORS)
CORS_ORIGIN=front-end-url

# URL pública da própria API, usada pelo Swagger para montar o servidor em /api-docs
API_PUBLIC_URL=url-deploy-api
